{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "__HOME__/.local/bin/codebase-memory-mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--browser",
        "chromium"
      ],
      "enabled": true
    }
  },
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 4,
    "reserved": 3000
  },
  "share": "disabled",
  "default_agent": "orchestrator",
  "model": "opencode-go/mimo-v2.5",
  "small_model": "opencode-go/mimo-v2.5",
  "autoupdate": "notify"
}
